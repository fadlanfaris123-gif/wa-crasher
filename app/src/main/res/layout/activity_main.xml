<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06120D"
    android:padding="20dp">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="OTAX X VIRTEX\nCONTROL PANEL"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:shadowColor="#00FF88"
            android:shadowRadius="5"/>

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/ic_launcher_hacker"
            android:backgroundTint="#FF0055"
            android:text="⏻"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="20sp"/>
    </LinearLayout>

    <!-- Status Bar -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● SYSTEM ONLINE"
        android:textColor="#00FF88"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="22.34.14"
        android:textColor="#00FF88"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A3B2D"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"/>

    <TextView
        android:id="@+id/tvCrashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ CRAS WHATSAPP"
        android:textColor="#00FF88"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Gambar Hacker (Placeholder) -->
    <ImageView
        android:id="@+id/ivHacker"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="15dp"
        android:background="#0A1C16"
        android:src="@drawable/ic_launcher_hacker"
        android:scaleType="centerInside"
        app:layout_constraintTop_toBottomOf="@id/tvCrashTitle"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ANONYMOUS ID\nTARGET LOCKED"
        android:textColor="#00FF88"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@id/ivHacker"
        app:layout_constraintStart_toStartOf="@id/ivHacker"/>

    <!-- Input Nomor -->
    <EditText
        android:id="@+id/etNumber"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="628xxxxxxxxxx"
        android:textColor="#FFFFFF"
        android:textColorHint="#00FF88"
        android:backgroundTint="#00FF88"
        android:background="@drawable/ic_launcher_hacker"
        android:inputType="phone"
        android:fontFamily="monospace"
        android:padding="15dp"
        android:layout_marginTop="25dp"
        app:layout_constraintTop_toBottomOf="@id/ivHacker"/>

    <!-- Input Durasi -->
    <EditText
        android:id="@+id/etDuration"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Durasi (Menit)"
        android:textColor="#FFFFFF"
        android:textColorHint="#00FF88"
        android:backgroundTint="#00FF88"
        android:inputType="number"
        android:fontFamily="monospace"
        android:padding="15dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/etNumber"/>

    <!-- Tombol Eksekusi -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🚀 KIRIM CRAS WA"
        android:textColor="#000000"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:backgroundTint="#00FF88"
        android:layout_marginTop="25dp"
        app:layout_constraintTop_toBottomOf="@id/etDuration"/>

    <!-- Log Terminal -->
    <TextView
        android:id="@+id/tvLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#020A06"
        android:textColor="#00FF88"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:padding="10dp"
        android:scrollbars="vertical"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnStart"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OTAX X VIRTEX v2.4.1 - SECURE SESSION"
        android:textColor="#1A3B2D"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
